import { Button, CheckBox, ComboBox, LineEdit, TextEdit, StandardListView,
         VerticalBox, HorizontalBox, ScrollView, Palette } from "std-widgets.slint";

/// Brand colors (#D9005B, #333333) and theme dependent surfaces.
global Theme {
    in-out property <bool> dark;
    out property <color> primary: #D9005B;
    out property <color> primary-hover: #B8004C;
    out property <color> charcoal: #333333;
    out property <color> window: dark ? #262626 : #F2F2F2;
    out property <color> surface: dark ? #333333 : #FFFFFF;
    out property <color> text: dark ? #F2F2F2 : #333333;
    out property <color> muted: dark ? #B3B3B3 : #6B6B6B;
    out property <color> border: dark ? #4A4A4A : #DDDDDD;
}

component Hint inherits Text {
    font-size: 11px;
    color: Theme.muted;
    wrap: word-wrap;
}

component Title inherits Text {
    font-size: 14px;
    font-weight: 600;
    color: Theme.text;
}

/// Rounded, bordered panel used to group related settings.
component Card inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    background: Theme.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border;
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        if root.title != "": HorizontalLayout {
            spacing: 8px;
            Rectangle {
                width: 4px;
                border-radius: 2px;
                background: Theme.primary;
            }
            Title { text: root.title; }
        }
        if root.subtitle != "": Hint { text: root.subtitle; }
        @children
    }
}

component Field inherits HorizontalLayout {
    in property <string> label;
    spacing: 8px;
    Text {
        text: root.label;
        min-width: 170px;
        vertical-alignment: center;
        color: Theme.text;
    }
}

component ListEditor inherits Card {
    in-out property <string> text;
    TextEdit {
        text <=> root.text;
        min-height: 100px;
        vertical-stretch: 1;
        font-size: 13px;
    }
}

component FileBar inherits HorizontalLayout {
    in property <string> label;
    in-out property <string> path;
    spacing: 8px;
    Text { text: root.label; vertical-alignment: center; color: Theme.text; }
    LineEdit { text <=> root.path; horizontal-stretch: 1; }
    @children
}

/// Filled button in the brand color for the main action of a page.
component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    min-width: label.preferred-width + 32px;
    height: 40px;
    border-radius: 20px;
    background: !root.enabled ? Theme.border
        : touch.pressed ? Theme.primary-hover.darker(0.1)
        : touch.has-hover ? Theme.primary-hover : Theme.primary;
    label := Text {
        text: root.text;
        color: root.enabled ? #FFFFFF : Theme.muted;
        font-weight: 600;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component ProgressBar inherits Rectangle {
    in property <float> progress;
    height: 8px;
    border-radius: 4px;
    background: Theme.border;
    Rectangle {
        x: 0;
        width: parent.width * clamp(root.progress, 0, 1);
        border-radius: parent.border-radius;
        background: Theme.primary;
    }
}

/// Row of selectable labels with a brand colored underline.
component TabBar inherits HorizontalLayout {
    in property <[string]> tabs;
    in-out property <int> current;
    spacing: 4px;
    for tab[index] in root.tabs: Rectangle {
        min-width: tab-label.preferred-width + 32px;
        height: 40px;
        tab-label := Text {
            text: tab;
            font-size: 14px;
            font-weight: index == root.current ? 700 : 500;
            color: index == root.current ? Theme.primary : Theme.text;
        }
        Rectangle {
            y: parent.height - self.height;
            height: 3px;
            border-radius: 1.5px;
            background: index == root.current ? Theme.primary
                : tab-touch.has-hover ? Theme.border : transparent;
        }
        tab-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.current = index; }
        }
    }
}

/// Segmented switch for the color theme, drawn on the dark header.
component ThemeSwitch inherits Rectangle {
    in-out property <int> current;
    border-radius: 16px;
    border-width: 1px;
    border-color: #FFFFFF40;
    height: 32px;
    HorizontalLayout {
        padding: 2px;
        for option[index] in ["System", "Light", "Dark"]: Rectangle {
            min-width: option-label.preferred-width + 20px;
            border-radius: 14px;
            background: index == root.current ? Theme.primary
                : option-touch.has-hover ? #FFFFFF20 : transparent;
            option-label := Text {
                text: option;
                font-size: 12px;
                color: #FFFFFF;
            }
            option-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.current = index; }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Pisi ISO Creator";
    icon: @image-url("pisi-logo.svg");
    preferred-width: 1100px;
    preferred-height: 700px;
    min-width: 760px;
    min-height: 520px;

    // ---- Project ----
    in-out property <string> project-path: "pisi-project.toml";
    in-out property <string> distro-name;
    in-out property <string> distro-version;
    in-out property <string> volume-label;
    in-out property <string> hostname;
    in-out property <string> live-user;
    in-out property <string> live-password;
    in-out property <string> work-dir;
    in-out property <string> output-iso;
    in-out property <string> compression: "xz";
    in-out property <string> kernel-cmdline;
    in-out property <bool> live-initramfs: true;
    in-out property <string> post-install-script;
    // ---- Packages ----
    in-out property <string> repositories;
    in-out property <string> components;
    in-out property <string> packages;
    in-out property <string> excluded-packages;
    in-out property <string> index-source;
    in-out property <string> index-status: "No repository index loaded!";
    in-out property <string> search-text;
    in property <[StandardListViewItem]> search-results;
    in-out property <int> selected-result: -1;
    in property <string> package-details;
    in property <bool> index-loading;
    // ---- Edit ISO ----
    in-out property <string> edit-job-path: "pisi-edit.toml";
    in-out property <string> edit-input-iso;
    in-out property <string> edit-output-iso;
    in-out property <string> edit-work-dir;
    in-out property <string> edit-volume-label;
    in-out property <string> edit-repositories;
    in-out property <string> edit-install;
    in-out property <string> edit-remove;
    in-out property <bool> edit-upgrade;
    in-out property <string> edit-compression: "xz";
    in-out property <string> edit-script;
    // ---- Run state ----
    in-out property <bool> dry-run: true;
    in property <bool> running;
    in property <float> progress;
    in property <string> status-text: "Ready.";
    in property <string> log-text;
    in property <[string]> compressions: ["xz", "zstd", "gzip", "lzo", "lz4"];

    // ---- Appearance ----
    /// 0 = follow the system, 1 = light, 2 = dark.
    in-out property <int> theme: 0;
    property <int> current-tab: 0;
    // Remembered before the first override so "System" can be restored.
    property <bool> system-dark;

    callback new-project();
    callback open-project();
    callback save-project();
    callback validate-project();
    callback show-plan();
    callback build-iso();
    callback load-index();
    callback search(string);
    callback select-package(int);
    callback add-selected(string);
    callback load-edit-job();
    callback save-edit-job();
    callback show-edit-plan();
    callback edit-iso();
    callback cancel();
    callback clear-log();

    function apply-theme() {
        Theme.dark = root.theme == 2 || (root.theme == 0 && root.system-dark);
        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
    }
    init => {
        root.system-dark = Palette.color-scheme == ColorScheme.dark;
        root.apply-theme();
    }
    changed theme => { root.apply-theme(); }

    background: Theme.window;

    VerticalLayout {
        // ---- Header ----
        Rectangle {
            background: Theme.charcoal;
            VerticalLayout {
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 10px;
                    padding-bottom: 10px;
                    spacing: 12px;
                    // White plate keeps the logo's #333333 outline visible on the dark header.
                    Rectangle {
                        width: 44px;
                        height: 44px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 10px;
                        background: #FFFFFF;
                        Image {
                            width: 36px;
                            height: 36px;
                            source: @image-url("pisi-logo.svg");
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: "Pisi ISO Creator";
                            font-size: 18px;
                            font-weight: 700;
                            color: #FFFFFF;
                        }
                        Text {
                            text: "Build and edit live ISO images of Pisi GNU/Linux";
                            font-size: 12px;
                            color: #FFFFFFB3;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        ThemeSwitch { current <=> root.theme; }
                    }
                }
                Rectangle {
                    height: 3px;
                    background: Theme.primary;
                }
            }
        }

        VerticalBox {
            VerticalLayout {
                vertical-stretch: 3;
                spacing: 8px;
                TabBar {
                    tabs: ["Project", "Packages", "Edit ISO"];
                    current <=> root.current-tab;
                }

                if root.current-tab == 0: VerticalLayout {
                        ScrollView {
                            VerticalBox {
                                FileBar {
                                    label: "Project file:";
                                    path <=> root.project-path;
                                    Button { text: "New"; clicked => { root.new-project(); } }
                                    Button { text: "Open"; clicked => { root.open-project(); } }
                                    Button { text: "Save"; clicked => { root.save-project(); } }
                                }
                                HorizontalLayout {
                                    spacing: 12px;
                                    Card {
                                        title: "Distribution";
                                        subtitle: "Shown in the boot menu and written to /etc/os-release.";
                                        horizontal-stretch: 1;
                                        Field { label: "Name:"; LineEdit { text <=> root.distro-name; } }
                                        Field { label: "Version:"; LineEdit { text <=> root.distro-version; } }
                                        Field { label: "Volume label:"; LineEdit { text <=> root.volume-label; placeholder-text: "PISI_LIVE (max. 32 chars)"; } }
                                        Field { label: "Hostname:"; LineEdit { text <=> root.hostname; } }
                                        Field { label: "Live user:"; LineEdit { text <=> root.live-user; placeholder-text: "empty = no live user"; } }
                                        Field { label: "Live password:"; LineEdit { text <=> root.live-password; input-type: password; placeholder-text: "empty = no password"; } }
                                    }
                                    Card {
                                        title: "Image";
                                        subtitle: "Where and how the ISO image is built.";
                                        horizontal-stretch: 1;
                                        Field { label: "Work directory:"; LineEdit { text <=> root.work-dir; } }
                                        Field { label: "Output ISO:"; LineEdit { text <=> root.output-iso; } }
                                        Field {
                                            label: "SquashFS compression:";
                                            ComboBox { model: root.compressions; current-value <=> root.compression; }
                                        }
                                        Field { label: "Kernel parameters:"; LineEdit { text <=> root.kernel-cmdline; } }
                                        CheckBox {
                                            text: "Generate live initramfs (mkinitcpio, pisilive hook)";
                                            checked <=> root.live-initramfs;
                                        }
                                    }
                                }
                                ListEditor {
                                    title: "Post-install script";
                                    subtitle: "Shell script run inside the chroot (/bin/sh -e) after all packages are configured.";
                                    text <=> root.post-install-script;
                                }
                            }
                        }
                        HorizontalBox {
                            alignment: end;
                            Button { text: "Validate"; clicked => { root.validate-project(); } }
                            Button { text: "Show Build Plan"; clicked => { root.show-plan(); } }
                            PrimaryButton {
                                text: root.dry-run ? "Build ISO (Dry Run)" : "Build ISO";
                                enabled: !root.running;
                                clicked => { root.build-iso(); }
                            }
                        }
                }

                if root.current-tab == 1: HorizontalBox {
                        ScrollView {
                            horizontal-stretch: 1;
                            VerticalBox {
                                ListEditor {
                                    title: "PiSi Repositories";
                                    subtitle: "One '<name> <pisi-index.xml(.xz) URL>' per line.";
                                    text <=> root.repositories;
                                }
                                ListEditor {
                                    title: "Components";
                                    subtitle: "Installed with their sub-components, e.g. system.base.";
                                    text <=> root.components;
                                }
                                ListEditor {
                                    title: "Packages";
                                    subtitle: "One package per line; dependencies are resolved automatically.";
                                    text <=> root.packages;
                                }
                                ListEditor {
                                    title: "Excluded Packages";
                                    subtitle: "Removed again after installation.";
                                    text <=> root.excluded-packages;
                                }
                            }
                        }
                        Card {
                            title: "Repository Browser";
                            subtitle: "Load a repository index to search and add packages.";
                            horizontal-stretch: 1;
                            HorizontalLayout {
                                spacing: 6px;
                                LineEdit {
                                    text <=> root.index-source;
                                    placeholder-text: "pisi-index.xml.xz URL or local path";
                                    accepted => { root.load-index(); }
                                }
                                Button {
                                    text: root.index-loading ? "Loading…" : "Load Index";
                                    enabled: !root.index-loading;
                                    clicked => { root.load-index(); }
                                }
                            }
                            Hint { text: root.index-status; }
                            LineEdit {
                                text <=> root.search-text;
                                placeholder-text: "Search packages…";
                                edited(text) => { root.search(text); }
                            }
                            StandardListView {
                                vertical-stretch: 1;
                                model: root.search-results;
                                current-item <=> root.selected-result;
                                current-item-changed(index) => { root.select-package(index); }
                            }
                            Text {
                                text: root.package-details;
                                wrap: word-wrap;
                                min-height: 60px;
                                color: Theme.text;
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                Button {
                                    text: "+ Packages";
                                    enabled: root.selected-result >= 0;
                                    clicked => { root.add-selected("packages"); }
                                }
                                Button {
                                    text: "+ Excluded";
                                    enabled: root.selected-result >= 0;
                                    clicked => { root.add-selected("excluded"); }
                                }
                                Button {
                                    text: "+ Edit ISO";
                                    enabled: root.selected-result >= 0;
                                    clicked => { root.add-selected("edit-install"); }
                                }
                            }
                        }
                }

                if root.current-tab == 2: VerticalLayout {
                        ScrollView {
                            VerticalBox {
                                FileBar {
                                    label: "Edit job file:";
                                    path <=> root.edit-job-path;
                                    Button { text: "Open"; clicked => { root.load-edit-job(); } }
                                    Button { text: "Save"; clicked => { root.save-edit-job(); } }
                                }
                                Card {
                                    title: "Image";
                                    subtitle: "Modifies an existing live ISO and keeps its boot setup.";
                                    Field { label: "Input ISO:"; LineEdit { text <=> root.edit-input-iso; placeholder-text: "existing Pisi GNU/Linux ISO"; } }
                                    Field { label: "Output ISO:"; LineEdit { text <=> root.edit-output-iso; } }
                                    Field { label: "Work directory:"; LineEdit { text <=> root.edit-work-dir; } }
                                    Field { label: "New volume label:"; LineEdit { text <=> root.edit-volume-label; placeholder-text: "empty = keep original"; } }
                                    Field {
                                        label: "SquashFS compression:";
                                        ComboBox { model: root.compressions; current-value <=> root.edit-compression; }
                                    }
                                    CheckBox { text: "Upgrade all installed packages (pisi upgrade)"; checked <=> root.edit-upgrade; }
                                }
                                HorizontalLayout {
                                    spacing: 12px;
                                    ListEditor {
                                        title: "Packages to Install";
                                        subtitle: "One per line.";
                                        text <=> root.edit-install;
                                    }
                                    ListEditor {
                                        title: "Packages to Remove";
                                        subtitle: "One per line.";
                                        text <=> root.edit-remove;
                                    }
                                }
                                ListEditor {
                                    title: "Additional Repositories";
                                    subtitle: "One '<name> <pisi-index.xml(.xz) URL>' per line, added to the image.";
                                    text <=> root.edit-repositories;
                                }
                                ListEditor {
                                    title: "Post-Install Script";
                                    subtitle: "Shell script run inside the image's chroot (/bin/sh -e).";
                                    text <=> root.edit-script;
                                }
                            }
                        }
                        HorizontalBox {
                            alignment: end;
                            Button { text: "Show Edit Plan"; clicked => { root.show-edit-plan(); } }
                            PrimaryButton {
                                text: root.dry-run ? "Edit ISO (Dry Run)" : "Edit ISO";
                                enabled: !root.running;
                                clicked => { root.edit-iso(); }
                            }
                        }
                }
            }

            // ---- Run status ----
            Card {
                HorizontalLayout {
                    spacing: 12px;
                    CheckBox {
                        text: "Dry run (only show commands)";
                        checked <=> root.dry-run;
                        enabled: !root.running;
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        ProgressBar { progress: root.progress; }
                    }
                    Button { text: "Cancel"; enabled: root.running; clicked => { root.cancel(); } }
                    Button { text: "Clear Log"; clicked => { root.clear-log(); } }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        width: 10px;
                        height: 10px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 5px;
                        background: root.running ? Theme.primary : Theme.border;
                    }
                    Text {
                        text: root.status-text;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                        color: Theme.text;
                    }
                }
            }

            Rectangle {
                vertical-stretch: 2;
                min-height: 100px;
                background: Theme.charcoal;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.border;
                clip: true;
                log-view := ScrollView {
                    content-width: max(self.visible-width, log-label.preferred-width + 16px);
                    content-height: max(self.visible-height, log-label.preferred-height + 16px);
                    log-label := Text {
                        x: 8px;
                        y: 8px;
                        text: root.log-text;
                        font-family: "monospace";
                        font-size: 12px;
                        wrap: no-wrap;
                        color: #E6E6E6;
                    }
                }
            }
        }
    }

    // Keep the newest log output visible.
    changed log-text => {
        log-view.content-y = min(0px, log-view.visible-height - log-view.content-height);
    }
}
